# Copiar como .env en la raíz del proyecto (en tu PC y en la EC2). Lo usa docker compose.
DB_ROOT_PASSWORD=
DB_USER=restaurante_app
DB_PASSWORD=
# Generar con: openssl rand -hex 32
JWT_SECRET=
# Desde dónde se abre el cliente. En la EC2: la URL del sitio de S3, sin "/" al final
CORS_ORIGIN=http://localhost:5173
